<merge
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:id="@+id/suggestions_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false" />
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <!-- Provide audio and haptic feedback by ourselves based on the keyboard settings.
         We just need to ignore the system's audio and haptic feedback settings. -->
    <LinearLayout
        android:id="@+id/important_notice_strip"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_suggestions_strip_horizontal_margin"
        android:layout_marginRight="@dimen/config_suggestions_strip_horizontal_margin"
        android:hapticFeedbackEnabled="false"
        android:soundEffectsEnabled="false" >
        <TextView
            android:id="@+id/important_notice_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="6sp"
            android:textSize="16sp"
            style="?attr/suggestionWordStyle" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/glass_toolbar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingStart="48dp"
        android:paddingEnd="4dp"
        android:layoutDirection="ltr"
        android:visibility="gone">
        <ImageButton
            android:id="@+id/glass_toolbar_clipboard"
            style="@style/GlassToolbarButton"
            android:contentDescription="@string/glass_toolbar_clipboard"
            android:src="@drawable/ic_f7_doc_on_clipboard" />
        <ImageButton
            android:id="@+id/glass_toolbar_edit"
            style="@style/GlassToolbarButton"
            android:contentDescription="@string/glass_toolbar_text_editing"
            android:src="@drawable/ic_f7_text_cursor" />
        <ImageButton
            android:id="@+id/glass_toolbar_one_handed"
            style="@style/GlassToolbarButton"
            android:contentDescription="@string/glass_toolbar_one_handed"
            android:src="@drawable/ic_f7_hand_point_right" />
        <ImageButton
            android:id="@+id/glass_toolbar_theme"
            style="@style/GlassToolbarButton"
            android:contentDescription="@string/glass_toolbar_theme"
            android:src="@drawable/ic_f7_paintbrush" />
        <ImageButton
            android:id="@+id/glass_toolbar_settings"
            style="@style/GlassToolbarButton"
            android:contentDescription="@string/glass_toolbar_settings"
            android:src="@drawable/ic_f7_gear_alt" />
        <TextView
            android:id="@+id/glass_clip_chip"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/glass_chip_background"
            android:drawableStart="@drawable/ic_glass_chip_paste"
            android:drawablePadding="6dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:textColor="@color/glass_suggestion_text"
            android:textSize="15sp"
            android:visibility="invisible" />
        <ImageButton
            android:id="@+id/glass_toolbar_hide"
            style="@style/GlassToolbarButton"
            android:contentDescription="@string/glass_toolbar_hide_keyboard"
            android:src="@drawable/ic_f7_keyboard_chevron_compact_down" />
    </LinearLayout>
    <TextView
        android:id="@+id/glass_dictation_status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/glass_dictation_listening"
        android:textColor="@color/glass_suggestion_secondary"
        android:textSize="16sp"
        android:visibility="gone" />
    <ImageButton
        android:id="@+id/glass_strip_grid"
        style="@style/GlassToolbarButton"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/glass_toolbar_more"
        android:src="@drawable/ic_f7_square_grid_2x2" />
    <ImageButton
        android:id="@+id/suggestions_strip_voice_key"
        android:layout_width="@dimen/config_suggestions_strip_edge_key_width"
        android:layout_height="fill_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/spoken_description_mic"
        style="?attr/suggestionWordStyle" />
</merge>
