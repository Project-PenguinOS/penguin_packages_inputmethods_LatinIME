<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="GlassBarButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">8.5dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/glass_icon_button_background</item>
        <item name="android:tint">@color/glass_icon</item>
        <item name="android:hapticFeedbackEnabled">false</item>
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <style name="GlassToolbarButton" parent="GlassBarButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
    </style>
</resources>
