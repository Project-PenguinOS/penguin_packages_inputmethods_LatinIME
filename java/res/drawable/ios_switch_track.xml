<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/ios_switch_on" />
            <corners android:radius="16dp" />
            <size android:width="51dp" android:height="31dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/ios_switch_off" />
            <corners android:radius="16dp" />
            <size android:width="51dp" android:height="31dp" />
        </shape>
    </item>
</selector>
